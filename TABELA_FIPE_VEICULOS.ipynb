!pip install -q openpyxl

import os
import time
import requests
import pandas as pd
from google.colab import files

# ==========================================
# CONFIGURAÇÕES INICIAIS
# ==========================================
ARQUIVO_PLANILHA = "caminhoes.xlsx"  # Nome do arquivo que você subiu no Colab
ARQUIVO_RESULTADO = "resultado_fipe.xlsx"

COL_MODELO = "MODELO"
COL_FABRICANTE = "FABRICANTE"
COL_ANO = "ANO MODELO"
COL_CODIGO_FIPE = "CODIGO FIPE"
COL_VALOR_FIPE = "TABELA FIPE"  # coluna onde o valor encontrado será gravado

BASE_URL = "https://fipe.parallelum.com.br/api/v2"
HEADERS = {"User-Agent": "Mozilla/5.0"}
TIPO_SLUG = "trucks"  # fixo: só caminhão

# ==========================================
# FUNÇÃO COM TRY/RETRY
# ==========================================
def get_com_retry(url, tentativas=3, espera=2):
    """Faz a requisição com até `tentativas` tentativas, esperando mais tempo entre cada uma."""
    for tentativa in range(tentativas):
        try:
            res = requests.get(url, headers=HEADERS, timeout=20)
            if res.status_code == 200:
                return res
            if res.status_code >= 500 and tentativa < tentativas - 1:
                print(f"      ⚠️ status {res.status_code}, tentando de novo ({tentativa+1}/{tentativas})...")
                time.sleep(espera * (tentativa + 1))
                continue
            return res
        except requests.exceptions.RequestException as e:
            if tentativa < tentativas - 1:
                print(f"      ⚠️ erro de conexão, tentando de novo ({tentativa+1}/{tentativas})...")
                time.sleep(espera * (tentativa + 1))
                continue
            print(f"      ❌ falhou após {tentativas} tentativas: {e}")
            return None
    return None

# ==========================================
# BUSCA DIRETA POR CÓDIGO FIPE
# ==========================================
def buscar_por_codigo_fipe(codigo_fipe, ano_alvo):
    """
    Usa o código FIPE direto para achar o ano exato e trazer o preço.
    Retorna (dados_preco, status, anos_disponiveis)
    """
    codigo_fipe = str(codigo_fipe).strip()

    res_anos = get_com_retry(f"{BASE_URL}/{TIPO_SLUG}/{codigo_fipe}/years")
    if not res_anos or res_anos.status_code != 200:
        return None, "Código FIPE inválido ou não encontrado", ""

    anos = res_anos.json()
    if not anos:
        return None, "Nenhum ano disponível para esse código FIPE", ""

    anos_disponiveis_str = ", ".join(sorted({a['name'] for a in anos}))

    id_ano_exato = None
    for a in anos:
        if a['code'].startswith(str(ano_alvo)):
            id_ano_exato = a['code']
            break

    if not id_ano_exato:
        return None, f"Ano {ano_alvo} não existe para este código FIPE", anos_disponiveis_str

    res_preco = get_com_retry(f"{BASE_URL}/{TIPO_SLUG}/{codigo_fipe}/years/{id_ano_exato}")
    if not res_preco or res_preco.status_code != 200:
        return None, "Erro ao buscar preço", anos_disponiveis_str

    return res_preco.json(), "OK", anos_disponiveis_str

# ==========================================
# PROCESSAMENTO
# ==========================================
if not os.path.exists(ARQUIVO_PLANILHA):
    print(f"❌ Erro: O arquivo '{ARQUIVO_PLANILHA}' não foi encontrado na aba lateral de arquivos do Colab!")
else:
    print(f"📦 Carregando a planilha '{ARQUIVO_PLANILHA}'...")
    df = pd.read_excel(ARQUIVO_PLANILHA)

    if COL_VALOR_FIPE not in df.columns:
        df[COL_VALOR_FIPE] = ""

    df['FIPE_Status'] = ""
    df['FIPE_Nome_Oficial'] = ""
    df['FIPE_Mes_Referencia'] = ""
    df['FIPE_Anos_Disponiveis'] = ""

    print(f"Total de registros: {len(df)}\n")

    for index, row in df.iterrows():
        modelo      = str(row.get(COL_MODELO, '')).strip()
        fabricante  = str(row.get(COL_FABRICANTE, '')).strip()
        ano_modelo  = str(row.get(COL_ANO, '')).strip()
        codigo_fipe = str(row.get(COL_CODIGO_FIPE, '')).strip()

        if '.' in ano_modelo: ano_modelo = ano_modelo.split('.')[0]
        if codigo_fipe.endswith('.0'): codigo_fipe = codigo_fipe[:-2]

        if not codigo_fipe or codigo_fipe.lower() == 'nan':
            df.at[index, 'FIPE_Status'] = "Sem código FIPE informado"
            continue

        print(f"[{index+1}/{len(df)}] {fabricante} {modelo} ({ano_modelo}) | código {codigo_fipe}...")

        dados, status, anos_disp = buscar_por_codigo_fipe(codigo_fipe, ano_modelo)
        df.at[index, 'FIPE_Anos_Disponiveis'] = anos_disp

        if dados:
            print(f"   ↳ ✅ {dados['price']}")
            df.at[index, COL_VALOR_FIPE] = dados['price']
            df.at[index, 'FIPE_Status'] = "Sucesso"
            df.at[index, 'FIPE_Nome_Oficial'] = dados['model']
            df.at[index, 'FIPE_Mes_Referencia'] = dados['referenceMonth']
        else:
            print(f"   ↳ ❌ {status}")
            df.at[index, 'FIPE_Status'] = status

        time.sleep(1.0)

    print("\n📊 Resumo:")
    print(df['FIPE_Status'].value_counts())

    df.to_excel(ARQUIVO_RESULTADO, index=False)
    print(f"\n🎉 Concluído! Baixando o arquivo final '{ARQUIVO_RESULTADO}'...")
    files.download(ARQUIVO_RESULTADO)
